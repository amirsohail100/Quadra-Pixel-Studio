rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Free game files: only logged-in users may download; upload from the Firebase console
    match /games/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Premium game files: only users who own the game (users/{uid}/purchases/{gameKey} exists in Firestore).
    // Put a file at premium/<game name>/<file> and use "storage:premium/<game name>/<file>" in games-data.js.
    match /premium/{gameKey}/{allPaths=**} {
      allow read: if request.auth != null
                  && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/purchases/$(gameKey));
      allow write: if false;
    }

    // Pictures for community games (icon + screenshots), uploaded by the game's owner
    match /uploads/{uid}/{gameId}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.size < 3 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
